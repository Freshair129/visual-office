{
  "name": "zuri-visual-office",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs --preview",
    "assets": "node scripts/build-assets.mjs && node scripts/build-studio-assets.mjs && node scripts/build-office-blueprints.mjs && node scripts/build-tycoon-assets.mjs",
    "assets:manifest": "node scripts/asset-store.mjs manifest",
    "assets:verify": "node scripts/asset-store.mjs verify",
    "assets:push": "node scripts/asset-store.mjs push",
    "assets:pull": "node scripts/asset-store.mjs pull",
    "test": "node --test tests/*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "perf:hybrid": "node scripts/perf-hybrid.mjs",
    "build": "npm run assets && node scripts/build-rich.mjs && node scripts/build-worker.mjs",
    "release": "node scripts/build-office-release.mjs",
    "release:check": "node scripts/check-office-release.mjs",
    "release:serve": "node scripts/serve-office-release.mjs",
    "bridge": "node scripts/bridge.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "marked": "18.1.0",
    "mermaid": "12.1.0",
    "three": "0.180.0"
  }
}
